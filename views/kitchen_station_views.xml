<odoo>
  <record id="view_bsoft_station_tree" model="ir.ui.view">
    <field name="name">bsoft.kitchen.station.tree</field><field name="model">bsoft.kitchen.station</field>
    <field name="arch" type="xml"><tree editable="bottom">
      <field name="sequence" widget="handle"/><field name="name"/><field name="active"/>
      <field name="category_ids" widget="many2many_tags"/><field name="pos_config_ids" widget="many2many_tags"/>
      <field name="warning_minutes"/><field name="critical_minutes"/><field name="sound_enabled"/>
    </tree></field>
  </record>
  <record id="view_bsoft_station_form" model="ir.ui.view">
    <field name="name">bsoft.kitchen.station.form</field><field name="model">bsoft.kitchen.station</field>
    <field name="arch" type="xml"><form><sheet><group>
      <field name="name"/><field name="active"/><field name="sequence"/>
      <field name="category_ids" widget="many2many_tags"/><field name="pos_config_ids" widget="many2many_tags"/>
    </group><group string="Alertas"><field name="warning_minutes"/><field name="critical_minutes"/><field name="sound_enabled"/></group></sheet></form></field>
  </record>
  <record id="action_bsoft_stations" model="ir.actions.act_window">
    <field name="name">Estaciones de cocina</field><field name="res_model">bsoft.kitchen.station</field><field name="view_mode">tree,form</field>
  </record>
</odoo>
