<odoo>
  <record id="module_category_bsoft_kitchen" model="ir.module.category">
    <field name="name">BSOFT Kitchen Display</field><field name="sequence">35</field>
  </record>
  <record id="group_kitchen_cook" model="res.groups">
    <field name="name">Cocinero</field><field name="category_id" ref="module_category_bsoft_kitchen"/>
  </record>
  <record id="group_kitchen_manager" model="res.groups">
    <field name="name">Encargado de cocina</field><field name="category_id" ref="module_category_bsoft_kitchen"/>
    <field name="implied_ids" eval="[(4, ref('group_kitchen_cook'))]"/>
  </record>
  <record id="group_kitchen_admin" model="res.groups">
    <field name="name">Administrador de cocina</field><field name="category_id" ref="module_category_bsoft_kitchen"/>
    <field name="implied_ids" eval="[(4, ref('group_kitchen_manager'))]"/>
  </record>
</odoo>
